# AIR-OPD — Qwen3-4B, external guidance (External-G), K=3.
#
# The repair guidance is generated by a separate, larger model (Qwen3.5-27B)
# loaded as an independent co-located vLLM engine.
# Set SOCRATIC_REFLECTOR_MODEL_PATH below; everything else matches the self-guidance
# recipe so the two differ only in where the guidance comes from.
#
# Paths you must set for your own machine:
# MODEL_PATH   : the Qwen3-4B directory
# TRAIN_JSONL  : DAPO-Math-17K with verified GPT-5.5 reference solutions (see README.md)
# scripts/train.sh requires both MODEL_PATH and TRAIN_JSONL.
MODEL_PATH=
TRAIN_JSONL=
OUTPUT_DIR=./outputs/air_opd_qwen3_4b_external
RUN_ID=AIR_OPD_QWEN3_4B_EXTERNAL_K3

# --- distributed / batch -----------------------------------------------------
# 8 x H100 80GB. Effective batch = NUM_PROCESSES * PER_DEVICE_BS * GRAD_ACCUM = 32.
NUM_PROCESSES=8
PER_DEVICE_BS=1
GRAD_ACCUM=4
STEPS_PER_GENERATION=4
USE_DEEPSPEED=0
MASTER_PORT=30112

# --- optimization ------------------------------------------------------------
MAX_STEPS=100
SAVE_STEPS=20
SAVE_TOTAL_LIMIT=5
LEARNING_RATE=5e-6
LORA_R=64
LORA_ALPHA=128
DATA_SEED=42
MAX_TRAIN_ROWS=-1
SHUFFLE_DATASET=True
ATTN_IMPL=flash_attention_2
USE_LIGER_KERNEL=0
# H100 (SM 9.0). Change for other architectures.
TORCH_CUDA_ARCH_LIST=9.0

# --- on-policy sampling ------------------------------------------------------
MAX_COMPLETION_LENGTH=8192
MAX_LENGTH=19168
STUDENT_TEMPERATURE=1.1
STUDENT_TOP_P=0.95
STUDENT_TOP_K=20
VLLM_GPU_MEM=0.35
VLLM_ENFORCE_EAGER=0
VLLM_ENABLE_SLEEP=0
JSD_SEQUENCE_CHUNK_SIZE=256

# --- AIR-OPD method ----------------------------------------------------------
# K, the repair budget.
SOCRATIC_MAX_ROUNDS=3
DISTILL_MODE=guided
SOCRATIC_PRIVILEGE_MODE=repair_guidance
SOCRATIC_REPAIR_SELECTION_MODE=reference_adaptive_repair_replacement
SOCRATIC_REFERENCE_MULTIROUND=1
SOCRATIC_MAX_REPAIR_ATTEMPTS=1
# Supervise only trajectories whose first on-policy attempt failed.
SOCRATIC_SUPERVISION_SCOPE=initial_wrong_only
# The teacher receives the problem and repair guidance as privileged context.
SOCRATIC_KEY_IDEA_PRIVILEGE_CONTEXT=problem_only
SOCRATIC_SOLUTION_PRIVILEGE_MODE=exclude
# Supervision region: starts at the error anchor b_t ...
SOCRATIC_LOSS_MASK_MODE=after_error_quote
SOCRATIC_ERROR_QUOTE_LOCATOR_MODE=locatable
# ... and ends at e_t, the earliest blank-line block end retaining 1 - epsilon
# of the corrective signal.
SOCRATIC_ENDPOINT_MODE=cumulative_correction_coverage
SOCRATIC_ENDPOINT_EPSILON=0.10
# Outcome-aware stage weighting: w_t is proportional to gamma^t * rho^{s_t}.
SOCRATIC_ROUND_WEIGHT_MODE=trajectory_outcome_alpha08_rho15
SOCRATIC_ROUND_WEIGHT_ALPHA=0.8
SOCRATIC_ROUND_WEIGHT_RHO=1.5
SOCRATIC_TERMINAL_RETRY=False
# The failed attempt stays in the history as a prior assistant turn.
SOCRATIC_REFLECTION_CONTEXT_MODE=last_wrong
SOCRATIC_ERROR_ROUTE_MODE=legacy
SOCRATIC_WRONG_PAIR_FILTER_MODE=none

# --- repair-guidance generator ----------------------------------------------
# external_model = External-G. The guidance generator is the model at
# SOCRATIC_REFLECTOR_MODEL_PATH, loaded as its own vLLM engine alongside the
# student sampler. Point it at a local Qwen3.5-27B directory.
HINTER_BACKEND=external_model
# Path to the Qwen3.5-27B directory. Required for external_model.
SOCRATIC_REFLECTOR_MODEL_PATH=
SOCRATIC_REFLECTOR_GPU_MEMORY_UTILIZATION=0.18
SOCRATIC_REFLECTOR_MAX_MODEL_LEN=16384
SOCRATIC_REFLECTOR_MAX_NUM_SEQS=16
SOCRATIC_REFLECTOR_ENFORCE_EAGER=True
SOCRATIC_REFLECTION_PROMPT_MODE=adaptive_repair_self_xml_v1
SOCRATIC_REPAIR_GUIDANCE_PROMPTS=configs/prompts/repair_guidance_prompts.json
SOCRATIC_SELF_HINT_THINKING=1
HINT_MAX_NEW_TOKENS=8192
HINT_CONCURRENCY=4
HINT_TEMPERATURE=0.7
HINT_TOP_P=0.9

# --- validation fallbacks ----------------------------------------------------
# Validate answer leakage and anchor location. A rejected repair
# receives zero loss for that stage and stops further retries.
# Reference solutions remain private evidence for guidance generation.
SOCRATIC_LEAK_FALLBACK_MODE=safe_hint
SOCRATIC_ERROR_QUOTE_FALLBACK_MODE=quote_source_prefix

# --- verifier ----------------------------------------------------------------
# Requires math_verify 0.9.0.
SOCRATIC_MATH_VERIFIER_PROFILE=binary_math_verify_compat_v2

# --- logging / checkpointing -------------------------------------------------
SOCRATIC_STEP_CHECKPOINT_ENABLED=0
SOCRATIC_FULL_TRACE_ENABLED=1
SOCRATIC_SEMANTIC_TRACE_ENABLED=1
SOCRATIC_SEMANTIC_TRACE_FIRST_STEPS=100
SOCRATIC_SEMANTIC_TRACE_SAMPLE_RATE=1
SOCRATIC_SEMANTIC_TRACE_MAX_ROWS=20000
SOCRATIC_SEMANTIC_TRACE_TEXT_LIMIT=50000
SOCRATIC_HINT_DEBUG_SAMPLE_RATE=1
SOCRATIC_HINT_DEBUG_MAX_ROWS=20000
SOCRATIC_HINT_DEBUG_TEXT_LIMIT=50000
SOCRATIC_TRACE_ARCHIVE_ENABLED=0
SOCRATIC_EMPTY_CACHE_MODE=legacy
SOCRATIC_TASK_SMOKE_MODE=0
